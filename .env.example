# Copie para .env.local e preencha. NUNCA commite o .env.local.

# Supabase (Settings > API). A anon key é pública por design: só funciona com RLS.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role: SÓ no servidor (Vercel > Environment Variables). Ignora RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Domínio principal do SaaS (site de vendas). Subdomínios viram {slug}.dominio
NEXT_PUBLIC_ROOT_DOMAIN=unlockmenu.com.br
NEXT_PUBLIC_SITE_URL=https://unlockmenu.com.br

# WhatsApp de vendas (só números, com DDI)
NEXT_PUBLIC_WHATSAPP_VENDAS=5500000000000

# Slug do estabelecimento demo usado no site de vendas
NEXT_PUBLIC_DEMO_SLUG=demo-completo

# Segredo para gerar o hash do IP (rate limit sem guardar IP puro). Gere com: openssl rand -hex 32
IP_HASH_SECRET=

# Proteção anti-robô no login (Cloudflare Turnstile). Opcional, mas recomendado em produção.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Web Push (plano Completo). Gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@unlockmenu.com.br

# Protege a rota de cron (alerta de atraso para o gerente)
CRON_SECRET=

# Opcional: caminho do ffmpeg (se vazio usa o binário do pacote ffmpeg-static ou o do sistema)
FFMPEG_PATH=
